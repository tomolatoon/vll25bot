{
  "name": "vll25bot",
  "version": "1.0.0",
  "description": "Discord Bot for VLL25",
  "type": "module",
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun run --watch src/index.ts",
    "deploy": "bun run src/deploy-commands.ts",
    "clear": "bun run src/clear-commands.ts"
  },
  "dependencies": {
    "discord.js": "^14.14.1",
    "node-cron": "^4.2.1",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node-cron": "^3.0.11",
    "@types/uuid": "^11.0.0"
  }
}
