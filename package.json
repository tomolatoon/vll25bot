{
  "name": "vll25bot",
  "version": "1.0.0",
  "description": "Discord Bot for VLL25",
  "type": "module",
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun run --watch src/index.ts",
    "deploy": "bun run src/deploy-commands.ts",
    "clear": "bun run src/clear-commands.ts",
    "lint": "biome lint ./src",
    "lint-fix": "biome check --fix --unsafe ./src",
    "format": "biome format --write ./src",
    "test": "bun test"
  },
  "dependencies": {
    "discord.js": "^14.14.1",
    "uuid": "^13.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/bun": "latest",
    "@types/uuid": "^11.0.0"
  }
}
